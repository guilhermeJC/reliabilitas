# RELIABILITAS — estrutura de variáveis de ambiente (valores fictícios).
# Copie para .env e preencha com as credenciais reais (Supabase Dashboard → Settings → API).
# Nomenclatura única (F17): somente as chaves atuais (sb_publishable_/sb_secret_).
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxx
# Conexão direta ao Postgres (migrations): Dashboard → Settings → Database → Connection string (Session)
# Senha com '@' → URL-encode (%40)
SUPABASE_DB_URL=postgresql://postgres.SEU-PROJETO:SENHA@aws-1-sa-east-1.pooler.supabase.com:5432/postgres
# CA do pooler (TLS com verificação completa — certificado público, já versionado)
SUPABASE_DB_CA=config/supabase-ca.crt
# Painel de aprovação (/admin — DEV-046): senha única + segredo de assinatura do cookie.
# Gere o secret com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_PASSWORD=troque-esta-senha
ADMIN_SESSION_SECRET=gere-um-valor-aleatorio-de-32-bytes-em-hex
